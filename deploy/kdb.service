[Unit]
Description=KDB Befordringsfradrag Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kdb
ExecStart=/opt/kdb/bin/kdb-service -port 8080 -db /opt/kdb/database/kdb.db
Restart=always
RestartSec=5
LimitNOFILE=65535
Environment="PORT=8080"
Environment="DATABASE_PATH=/opt/kdb/database/kdb.db"
Environment="JWT_SECRET=replace-with-a-random-32-byte-secret"
LoadCredential=dar_token:/etc/kdb/dar_token

[Install]
WantedBy=multi-user.target
