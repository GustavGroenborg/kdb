# KDB Environment Configuration

# Server HTTP Port (optional, default: 8080)
PORT=8080

# Path to SQLite database file (optional, default: database/kdb.db)
DATABASE_PATH=database/kdb.db

# JWT secret key for signing user auth tokens
# Generate a secure 32-byte key with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-byte-secret

# Datafordeleren API token for Danish Address Register (DAR) GraphQL queries
# Used to resolve home addresses to municipalities and determine udkantskommune fradrag
DAR_API_TOKEN=your-datafordeler-api-token
